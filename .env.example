# URL фронтенда (абсолютные ссылки, CORS-настройки Laravel)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Laravel API — ТОЛЬКО для серверного кода Next:
#   1) next.config.ts — рерайты /api, /sanctum, /storage
#   2) lib/api-server.ts — Server Components ходят на бэк напрямую (сервер-к-серверу)
# NEXT_PUBLIC_ префикс НЕ нужен: адрес бэка не должен попадать в браузерный бандл.
# Клиентский код ходит через рерайты — для него всё relative.
API_URL_INTERNAL=http://localhost:8000

# Имя сессионной куки Laravel. ДОЛЖНО совпадать с SESSION_COOKIE на бэке
# (см. dating-api/.env.example, секция SESSION & SANCTUM).
#
# Используется в proxy.ts для optimistic-редиректа гостей на /login:
# если куки с этим именем нет — proxy сразу кидает на /login без полного
# server-render'а layout'а. Реальную валидацию сессии делает серверный
# layout через /api/admin/me, proxy — только оптимизация.
#
# На бэке в .env.example зафиксировано SESSION_COOKIE=dating_session —
# поэтому и здесь то же значение. Если на бэке переименуешь — синкни сюда.
NEXT_PUBLIC_SESSION_COOKIE=dating_session

NEXT_PUBLIC_REVERB_APP_KEY=local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http